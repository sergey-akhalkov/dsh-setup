{
  "name": "dsh-setup",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "A portable, installable DeepSeek Harness setup: plugin bundles, agent presets, and a static plugin market index",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.28.5 <12"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "gen": "node scripts/generate.ts",
    "gen:check": "node scripts/generate.ts --check",
    "dogfood": "node scripts/dogfood.ts",
    "ponytail:update": "node scripts/update-ponytail.ts",
    "answer-page:update": "node scripts/update-answer-page.ts",
    "openspec:update": "node scripts/update-openspec.ts",
    "validate:repo": "node scripts/validate-repo.ts",
    "validate:composition": "node scripts/validate-composition.ts",
    "validate:installer": "node scripts/validate-installer.ts",
    "reviews:check": "node scripts/reviews-check.ts",
    "reviews:export": "node scripts/reviews-check.ts --export",
    "hooks:install": "node scripts/install-hooks.ts",
    "validate": "pnpm check && pnpm gen:check && pnpm validate:repo && pnpm validate:composition && pnpm validate:installer",
    "generate:market": "node scripts/generate-market.ts",
    "release:prepare": "node scripts/release-prepare.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.3",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/semver": "7.8.0",
    "@vectorize-io/hindsight-coding-agents": "0.8.2",
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
