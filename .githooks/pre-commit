#!/bin/sh
# Audit the archived changes this commit stages before the commit exists.
# The audit fails closed: an unreadable staged range or missing approval refuses
# the commit and points at `pnpm reviews:check --all`.
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm was not found; run 'pnpm reviews:check --all' manually (fails closed)." >&2
  exit 1
fi
exec pnpm reviews:check --staged
