{
  "name": "@dsh-setup/plugin-exploratory-testing",
  "version": "0.48.1",
  "description": "Opt-in exploratory testing: state-driven focus selection, a read-only cycle change, and an outcome change for classified findings, regression tests, spec corrections, and knowledge capture",
  "license": "MIT",
  "icon": "./icon.svg",
