{
  "name": "@dsh-setup/plugin-openspec",
  "version": "0.31.7",
  "description": "OpenSpec spec-driven workflow: the six core OpenSpec skills packaged on demand from a pinned upstream release, plus a read-only right-sidebar panel for the workspace's active and archived changes, capability specs, specification history and git provenance, with the openspec CLI as a documented prerequisite",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.fragment.yml": "./cordis.fragment.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/change-list.js",
    "lib/change-list.d.ts",
    "lib/change-detail.js",
    "lib/change-detail.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "cordis.fragment.yml",
    "assets/openspec/LICENSE",
    "assets/guidance/task-lanes.md",
    "assets/openspec/openspec-apply-change/SKILL.md",
    "assets/openspec/openspec-archive-change/SKILL.md",
    "assets/openspec/openspec-explore/SKILL.md",
    "assets/openspec/openspec-propose/SKILL.md",
    "assets/openspec/openspec-sync-specs/SKILL.md",
    "assets/openspec/openspec-update-change/SKILL.md",
    "openspec.lock.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
