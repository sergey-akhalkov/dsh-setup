{
  "name": "@dsh-setup/plugin-goal-continuity",
  "version": "0.21.0",
  "description": "Goal continuity: re-arms a disarmed active goal after recoverable harness stops, resumes after a loop-guard reset, extends the round cap within bounds, and reviews every proposed block with an independent read-only subagent before it can end the run",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.fragment.yml": "./cordis.fragment.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/blocker-review.md",
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "cordis.fragment.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
