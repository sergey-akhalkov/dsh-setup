{
  "name": "@dsh-setup/setup",
  "version": "0.2.1",
  "description": "The full portable DeepSeek Harness setup: every plugin bundle plus owner defaults, installed as one bundle",
  "icon": "./icon.svg",
  "files": [
    "cordis.patch.yml",
    "defaults.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "@dsh-setup/plugin-composer-clock": "0.2.1",
    "@dsh-setup/plugin-nuphus-mcp": "0.2.1",
    "@dsh-setup/plugin-openspec": "0.2.1",
    "@dsh-setup/plugin-ponytail": "0.2.1",
    "@dsh-setup/plugin-rtk": "0.2.1",
    "@dsh-setup/plugin-rust": "0.2.1",
    "@dsh-setup/plugin-serena": "0.2.1",
    "@dsh-setup/plugin-working-principles": "0.2.1"
  },
  "bundleDependencies": [
    "@dsh-setup/plugin-composer-clock",
    "@dsh-setup/plugin-nuphus-mcp",
    "@dsh-setup/plugin-openspec",
    "@dsh-setup/plugin-ponytail",
    "@dsh-setup/plugin-rtk",
    "@dsh-setup/plugin-rust",
    "@dsh-setup/plugin-serena",
    "@dsh-setup/plugin-working-principles"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
