    "@dsh-setup/plugin-codex-subagent": "0.11.0",
    "@dsh-setup/plugin-delegation-rules": "0.11.0",
    "@dsh-setup/plugin-goal-continuity": "0.11.0",
    "@dsh-setup/plugin-hindsight": "0.11.0",
    "@dsh-setup/plugin-loop-guard": "0.11.0",
    "@dsh-setup/plugin-mcp-lazy": "0.11.0",
    "@dsh-setup/plugin-nuphus-mcp": "0.11.0",
    "@dsh-setup/plugin-openspec": "0.11.0",
    "@dsh-setup/plugin-ponytail": "0.11.0",
    "@dsh-setup/plugin-rtk": "0.11.0",
    "@dsh-setup/plugin-rust": "0.11.0",
    "@dsh-setup/plugin-serena": "0.11.0",
    "@dsh-setup/plugin-working-principles": "0.11.0",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@openai/codex": "0.164.0",
    "@vectorize-io/hindsight-coding-agents": "0.8.2"
  },
  "bundleDependencies": [
    "@dsh-setup/plugin-admin-indicator",
    "@dsh-setup/plugin-codex-subagent",
    "@dsh-setup/plugin-delegation-rules",
    "@dsh-setup/plugin-goal-continuity",
    "@dsh-setup/plugin-hindsight",
    "@dsh-setup/plugin-loop-guard",
    "@dsh-setup/plugin-mcp-lazy",
    "@dsh-setup/plugin-nuphus-mcp",
    "@dsh-setup/plugin-openspec",
    "@dsh-setup/plugin-ponytail",
    "@dsh-setup/plugin-rtk",
    "@dsh-setup/plugin-rust",
    "@dsh-setup/plugin-serena",
