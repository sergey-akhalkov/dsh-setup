{
  "name": "@dsh-setup/plugin-openspec",
  "version": "0.14.1",
  "description": "OpenSpec spec-driven workflow: the six core OpenSpec skills packaged on demand from a pinned upstream release, with the openspec CLI as a documented prerequisite",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.fragment.yml": "./cordis.fragment.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "cordis.fragment.yml",
    "assets/openspec/LICENSE",
    "assets/guidance/task-lanes.md",
    "assets/openspec/openspec-apply-change/SKILL.md",
    "assets/openspec/openspec-archive-change/SKILL.md",
    "assets/openspec/openspec-explore/SKILL.md",
    "assets/openspec/openspec-propose/SKILL.md",
    "assets/openspec/openspec-sync-specs/SKILL.md",
    "assets/openspec/openspec-update-change/SKILL.md",
    "openspec.lock.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
