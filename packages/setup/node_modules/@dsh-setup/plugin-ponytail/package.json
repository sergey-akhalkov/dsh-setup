{
  "name": "@dsh-setup/plugin-ponytail",
  "version": "0.4.0",
  "description": "Ponytail lazy-senior-dev skill and default-on ruleset delivered from a pinned upstream prompt (MIT, by Dietrich Gebert)",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.fragment.yml": "./cordis.fragment.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "cordis.fragment.yml",
    "assets/ponytail/SKILL.md",
    "assets/ponytail/AGENTS.md",
    "assets/ponytail/LICENSE",
    "ponytail.lock.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
