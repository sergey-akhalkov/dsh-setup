{
  "v": 1,
  "id": "task-review",
  "name": "Task review",
  "description": "Review a checked task through the native review executor when the change's tasks.md changes and confirm its portable approval coverage.",
  "version": 1,
  "trigger": {
    "kind": "fs.change",
    "match": { "path": "openspec/changes/{name}/tasks.md" },
    "mode": "active",
    "dedupe": "path+content-hash"
  },
  "settings": {
    "allowModelStart": true,
    "risk": "low",
    "gateOwnership": "own",
    "maxBlocks": 3,
    "allowIntent": false,
    "gate": "review",
    "gateIdentity": "task-review"
  },
  "steps": [
    {
      "id": "review",
      "title": "Review the checked task",
      "executor": "review",
      "review": { "target": "codex", "instruction": "review-task", "scope": "task" },
      "evidence": {
        "kind": "record",
        "rule": "task-review",
        "change": "{name}",
        "scope": "task",
        "task": "{taskId}",
        "verdicts": ["PASS", "ERROR"],
        "path": ".dsh/workflows/records/task-review/{name}/tasks/{taskId}.json"
      },
      "next": "complete-review",
      "blockTurnClose": true
    },
    {
      "id": "complete-review",
      "title": "Confirm the completion coverage",
      "executor": "main",
      "prompt": "Confirm the portable task-review PASS coverage for every checked task before the change can complete. Do not tick or archive; a missing or non-PASS checked task keeps this step open.",
      "evidence": { "kind": "check", "source": "task-review-coverage" },
      "next": "end",
      "blockTurnClose": true
    }
  ]
}
