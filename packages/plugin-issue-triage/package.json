{
  "name": "@dsh-setup/plugin-issue-triage",
  "version": "0.62.1",
  "description": "Opt-in issue triage: turns open GitHub issues into evidence-backed verdicts, closes duplicates and already-fixed issues with a comment, clusters the valid ones into at most three change drafts, and reports one summary table",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.fragment.yml": "./cordis.fragment.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "cordis.fragment.yml",
    "assets/issue-triage/SKILL.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
